{
  "mode": "local",
  "target_os": "windows",
  "repo_url": "https://github.com/roger312/hospital-claw.git",
  "repo_branch": "feature/windows-treatment-app",
  "deploy_root_dir": "~/.workbuddy",
  "dry_run": false,
  "qmd": {
    "enabled": true,
    "start": true,
    "install_if_missing": true,
    "install_machine_tools": true,
    "restart": false,
    "host": "localhost",
    "port": 8181
  },
  "optional_components": {
    "wechat_router": true,
    "wechat_decrypt": true
  },
  "wechat_decrypt": {
    "enabled": true,
    "generate_mcp_template": true,
    "launch_web_ui": false,
    "web_host": "localhost",
    "web_port": 5678
  },
  "ssh": {
    "host": "",
    "user": "",
    "port": 22,
    "identity_file": ""
  },
  "gemma": {
    "enabled": true,
    "model": "gemma3:4b",
    "ollama_base_url": "http://127.0.0.1:11434",
    "deploy_via": "openai-compatible"
  }
}
